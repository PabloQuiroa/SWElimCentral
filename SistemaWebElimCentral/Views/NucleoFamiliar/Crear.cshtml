@* Pablo José Quiroa Martínez - 0901-22-2929 *@
@{
    ViewData["Title"] = "Nueva Familia";
    string sDpiPadre = ViewBag.DpiPadre as string ?? "";
    string sDpiMadre = ViewBag.DpiMadre as string ?? "";
    string sNombrePadre = ViewBag.NombrePadre as string ?? "";
    string sNombreMadre = ViewBag.NombreMadre as string ?? "";
}

<style>
    :root {
        --morado-oscuro: #4A0E6E;
        --morado-medio: #7B2D9E;
        --dorado: #C9A84C;
        --dorado-claro: #E8C97A;
        --crema: #F5F0E8;
    }

    .page-header {
        background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
        border-radius: 15px;
        padding: 20px 25px;
        margin-bottom: 20px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .page-header-titulo {
        font-family: 'Cinzel', serif;
        font-size: 20px;
        font-weight: 700;
        margin: 0;
    }

    .form-card {
        background: white;
        border-radius: 12px;
        overflow: visible;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        max-width: 750px;
    }

    .form-card-header {
        border-radius: 12px 12px 0 0;
        background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
        padding: 15px 20px;
        color: white;
        font-family: 'Cinzel', serif;
        font-size: 13px;
        font-weight: 600;
    }

    .form-card-body {
        padding: 25px;
    }

    .form-label {
        color: var(--morado-oscuro);
        font-weight: 700;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-control, .form-select {
        border-radius: 10px;
        font-size: 13px;
        padding: 10px 12px;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--morado-medio);
            box-shadow: 0 0 0 0.2rem rgba(123, 45, 158, 0.15);
        }

    .nota {
        background: var(--crema);
        border-left: 4px solid var(--dorado);
        border-radius: 8px;
        padding: 10px 15px;
        font-size: 12px;
        color: #555;
    }

    .btn-guardar {
        background: linear-gradient(135deg, var(--dorado), var(--dorado-claro));
        color: var(--morado-oscuro);
        border: none;
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 13px;
        transition: all 0.3s;
    }

        .btn-guardar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(201, 168, 76, 0.4);
        }

    .btn-cancelar {
        background: #f0f0f0;
        color: #555;
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13px;
        text-decoration: none;
    }

        .btn-cancelar:hover {
            background: #e0e0e0;
            color: #333;
        }
</style>

<div class="page-header">
    <div>
        <p class="page-header-titulo">
            <i class="bi bi-house-add-fill me-2"></i>Nueva Familia
        </p>
        <small style="color: var(--dorado-claro); font-size: 12px;">
            Registro de un nuevo núcleo familiar
        </small>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mb-3"
         style="border-radius: 10px; border-left: 4px solid #dc3545; max-width: 750px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @ViewBag.Error
    </div>
}

<div class="form-card">
    <div class="form-card-header">
        <i class="bi bi-pencil-square me-2"></i>Datos de la familia
    </div>
    <div class="form-card-body">
        <form method="post" action="/NucleoFamiliar/Crear">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Nombre de la familia *</label>
                <input type="text" name="sNombreFamilia" class="form-control"
                       maxlength="100" required
                       placeholder="Ej. Familia Pérez López"
                       value="@ViewBag.NombreFamilia" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Esposo / Padre</label>
                    <div class="buscador-miembro" data-sexo="M" data-grupo="">
                        <input type="text" class="form-control buscador-texto" autocomplete="off"
                               placeholder="Escriba el nombre o DPI del esposo..."
                               value="@(string.IsNullOrEmpty(sDpiPadre) ? "" : sNombrePadre + " - " + sDpiPadre)" />
                        <input type="hidden" name="sDpiPadre" class="buscador-valor" value="@sDpiPadre" />
                        <div class="buscador-resultados"></div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Esposa / Madre</label>
                    <div class="buscador-miembro" data-sexo="F" data-grupo="">
                        <input type="text" class="form-control buscador-texto" autocomplete="off"
                               placeholder="Escriba el nombre o DPI de la esposa..."
                               value="@(string.IsNullOrEmpty(sDpiMadre) ? "" : sNombreMadre + " - " + sDpiMadre)" />
                        <input type="hidden" name="sDpiMadre" class="buscador-valor" value="@sDpiMadre" />
                        <div class="buscador-resultados"></div>
                    </div>
                </div>
            </div>

            <div class="nota mb-4">
                <i class="bi bi-info-circle-fill me-1" style="color: var(--dorado);"></i>
                Escriba al menos 2 letras del nombre, apellido o DPI y elija de la lista. Solo aparecen miembros activos que todavía no pertenecen a otra familia.
                Debe seleccionar al menos a uno de los cónyuges. Los demás integrantes
                y los hijos menores se agregan desde el expediente de la familia.
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-guardar">
                    <i class="bi bi-save-fill me-1"></i>Guardar familia
                </button>
                <a href="/NucleoFamiliar" class="btn-cancelar">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@await Html.PartialAsync("_BuscadorMiembro")
