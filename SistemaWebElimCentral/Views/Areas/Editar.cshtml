@* Pablo José Quiroa Martínez - 0901-22-2929 *@
@model SistemaWebElimCentral.Models.Membresias.Mdl_Area_Servicio
@{
    ViewData["Title"] = "Editar Area";
}

<style>
    :root {
        --morado-oscuro: #4A0E6E;
        --morado-medio: #7B2D9E;
        --dorado: #C9A84C;
        --dorado-claro: #E8C97A;
        --crema: #F5F0E8;
    }

    .page-header {
        background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
        border-radius: 15px;
        padding: 20px 25px;
        margin-bottom: 20px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .page-header-titulo {
        font-family: 'Cinzel', serif;
        font-size: 20px;
        font-weight: 700;
        margin: 0;
    }

    .btn-regresar {
        background: rgba(255,255,255,0.2);
        color: white;
        border: 1px solid rgba(255,255,255,0.4);
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s;
    }

        .btn-regresar:hover {
            background: rgba(255,255,255,0.3);
            color: white;
        }

    .seccion-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        margin-bottom: 20px;
        max-width: 650px;
        margin-left: auto;
        margin-right: auto;
    }

    .seccion-header {
        background: var(--crema);
        padding: 12px 20px;
        border-left: 4px solid var(--dorado);
        font-family: 'Cinzel', serif;
        font-size: 13px;
        font-weight: 700;
        color: var(--morado-oscuro);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .seccion-body {
        padding: 25px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--morado-oscuro);
        margin-bottom: 5px;
    }

    .form-control {
        border-radius: 8px;
        font-size: 13px;
        border-color: #dee2e6;
    }

        .form-control:focus {
            border-color: var(--dorado);
            box-shadow: 0 0 0 0.2rem rgba(201, 168, 76, 0.25);
        }

    .btn-guardar {
        background: linear-gradient(135deg, var(--dorado), var(--dorado-claro));
        color: var(--morado-oscuro);
        border: none;
        padding: 12px 30px;
        border-radius: 10px;
        font-family: 'Cinzel', serif;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.3s;
        box-shadow: 0 4px 15px rgba(201, 168, 76, 0.3);
    }

        .btn-guardar:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(201, 168, 76, 0.4);
        }

    .btn-cancelar {
        background: var(--crema);
        color: var(--morado-oscuro);
        border: 1px solid #dee2e6;
        padding: 12px 25px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s;
    }

        .btn-cancelar:hover {
            background: #e9e4f0;
            color: var(--morado-oscuro);
        }

    .campo-requerido::after {
        content: ' *';
        color: red;
    }
</style>

<div class="page-header">
    <div>
        <p class="page-header-titulo">
            <i class="bi bi-pencil-fill me-2"></i>Editar area de Servicio
        </p>
        <small style="color: var(--dorado-claro); font-size: 12px;">
            Actualice la informacion del area o ministerio
        </small>
    </div>
    <a href="/Areas" class="btn-regresar">
        <i class="bi bi-arrow-left"></i> Regresar
    </a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3"
         style="border-radius: 10px; max-width: 650px; margin: 0 auto 15px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" action="/Areas/Editar">
    <input type="hidden" name="iIdArea" value="@Model.iPk_Id_Area" />

    <div class="seccion-card">
        <div class="seccion-header">
            <i class="bi bi-diagram-3-fill"></i> Datos del area
        </div>
        <div class="seccion-body">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label campo-requerido">
                        Nombre del area o Ministerio
                    </label>
                    <input type="text"
                           name="sNombreArea"
                           class="form-control"
                           value="@Model.sCmp_Nombre_Area"
                           maxlength="100"
                           required />
                </div>
                <div class="col-12">
                    <label class="form-label">Descripcion</label>
                    <textarea name="sDescripcion"
                              class="form-control"
                              rows="3"
                              maxlength="200">@Model.sCmp_Descripcion_Area</textarea>
                </div>
                <div class="col-12">
                    <label class="form-label">Lider del area</label>
                    <input type="text"
                           name="sLider"
                           class="form-control"
                           value="@Model.sCmp_Lider_Area"
                           maxlength="100" />
                </div>
            </div>
            <div class="d-flex gap-3 justify-content-end mt-4">
                <a href="/Areas" class="btn-cancelar">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </a>
                <button type="submit" class="btn-guardar">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</form>