@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Iglesia de Cristo Elim Central</title>

    @* Bootstrap 5 *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    @* Bootstrap Icons *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    @* Google Fonts - Cinzel + Lato *@
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lato:wght@300;400;600;700&display=swap" rel="stylesheet" />

    <style>
            :root {
                --morado-oscuro: #4A0E6E;
                --morado-medio: #7B2D9E;
                --dorado: #C9A84C;
                --dorado-claro: #E8C97A;
                --verde-uva: #4A6741;
                --crema: #F5F0E8;
            }

            body {
                background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Lato', sans-serif;
            }

                body::before {
                    content: '';
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: url('/images/logo_elim_color.png') center/cover no-repeat;
                    opacity: 0.05;
                    z-index: 0;
                }

            .card-login {
                border: none;
                border-radius: 20px;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
                width: 100%;
                max-width: 430px;
                position: relative;
                z-index: 1;
                overflow: hidden;
            }

            .card-header-login {
                background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
                padding: 35px 30px 25px;
                text-align: center;
                border: none;
                position: relative;
            }

                .card-header-login::after {
                    content: '';
                    position: absolute;
                    bottom: -1px;
                    left: 0;
                    width: 100%;
                    height: 30px;
                    background: white;
                    border-radius: 50% 50% 0 0 / 30px 30px 0 0;
                }

            .logo-elim {
                width: 110px;
                height: 110px;
                object-fit: contain;
                border-radius: 50%;
                border: 3px solid var(--dorado);
                padding: 5px;
                background: white;
                box-shadow: 0 4px 15px rgba(201, 168, 76, 0.4);
            }

            .titulo-iglesia {
                color: white;
                font-family: 'Cinzel', serif;
                font-size: 15px;
                font-weight: 700;
                margin-top: 12px;
                margin-bottom: 2px;
                letter-spacing: 1px;
                text-shadow: 1px 1px 3px rgba(0,0,0,0.3);
            }

            .subtitulo-sistema {
                color: var(--dorado-claro);
                font-family: 'Lato', sans-serif;
                font-size: 12px;
                font-weight: 300;
                letter-spacing: 2px;
                text-transform: uppercase;
                margin-bottom: 0;
            }

            .card-body-login {
                background: white;
                padding: 30px 35px;
            }

            .titulo-formulario {
                color: var(--morado-oscuro);
                font-family: 'Cinzel', serif;
                font-size: 22px;
                font-weight: 600;
                margin-bottom: 20px;
                text-align: center;
                letter-spacing: 1px;
            }

            .input-group-text {
                background-color: var(--crema);
                border-color: #dee2e6;
                color: var(--morado-medio);
            }

            .form-control {
                border-left: none;
                border-color: #dee2e6;
                background-color: white;
                font-family: 'Lato', sans-serif;
            }

                .form-control:focus {
                    box-shadow: 0 0 0 0.2rem rgba(201, 168, 76, 0.25);
                    border-color: var(--dorado);
                }

            .form-label {
                color: var(--morado-oscuro);
                font-family: 'Lato', sans-serif;
                font-weight: 600;
                font-size: 14px;
            }

            .btn-login {
                background: linear-gradient(135deg, var(--dorado), var(--dorado-claro));
                color: var(--morado-oscuro);
                border: none;
                width: 100%;
                padding: 12px;
                border-radius: 10px;
                font-family: 'Cinzel', serif;
                font-size: 14px;
                font-weight: 700;
                letter-spacing: 1px;
                transition: all 0.3s;
                box-shadow: 0 4px 15px rgba(201, 168, 76, 0.4);
            }

                .btn-login:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(201, 168, 76, 0.5);
                    color: var(--morado-oscuro);
                }

                .btn-login:active {
                    transform: translateY(0);
                }

            .btn-ojo {
                border-color: #dee2e6;
                border-left: none;
                color: var(--morado-medio);
                background: white;
            }

                .btn-ojo:hover {
                    background: var(--crema);
                    color: var(--morado-oscuro);
                    border-color: #dee2e6;
                }

            .card-footer-login {
                background: var(--crema);
                text-align: center;
                padding: 12px;
                border-top: 1px solid rgba(201, 168, 76, 0.3);
            }

                .card-footer-login small {
                    color: var(--morado-medio);
                    font-family: 'Lato', sans-serif;
                    font-size: 11px;
                    letter-spacing: 0.5px;
                }

            .linea-dorada {
                height: 3px;
                background: linear-gradient(90deg, transparent, var(--dorado), transparent);
                margin: 0 0 20px 0;
                border-radius: 2px;
            }

            .alert-danger {
                background-color: #fff5f5;
                border-color: #f5c6cb;
                color: #721c24;
                border-radius: 10px;
                font-size: 14px;
                font-family: 'Lato', sans-serif;
            }
    </style>
</head>
<body>

    <div class="card card-login">

        @* Encabezado *@
        <div class="card-header-login">
            <img src="~/images/logo_elim_color.png"
                 alt="Logo Iglesia de Cristo Elim Central"
                 class="logo-elim" />
            <p class="titulo-iglesia">Iglesia de Cristo Elim Central</p>
            <p class="subtitulo-sistema">Sistema de Gestión de Membresías</p>
        </div>

        @* Cuerpo *@
        <div class="card-body-login">

            <p class="titulo-formulario">Iniciar Sesión</p>
            <div class="linea-dorada"></div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post" action="/Login">

                <div class="mb-3">
                    <label class="form-label">
                        <i class="bi bi-person-fill me-1"></i>Usuario
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-person"></i>
                        </span>
                        <input type="text"
                               name="sUsername"
                               class="form-control"
                               placeholder="Ingrese su usuario"
                               required
                               autocomplete="off" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">
                        <i class="bi bi-lock-fill me-1"></i>Contraseña
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input type="password"
                               id="inputContrasena"
                               name="sContrasena"
                               class="form-control"
                               placeholder="Ingrese su contraseña"
                               required />
                        <button class="btn btn-ojo"
                                type="button"
                                onclick="toggleContrasena()"
                                title="Mostrar u ocultar contraseña">
                            <i class="bi bi-eye" id="iconoOjo"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-login">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Ingresar 
                </button>

            </form>
        </div>

        @* Pie *@
        <div class="card-footer-login">
            <small>
                <i class="bi bi-shield-lock me-1"></i>
                © 2026 Iglesia de Cristo Elim Central — Acceso autorizado únicamente
            </small>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            function toggleContrasena() {
                const input = document.getElementById('inputContrasena');
                const icono = document.getElementById('iconoOjo');

                if (input.type === 'password') {
                    input.type = 'text';
                    icono.classList.remove('bi-eye');
                    icono.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icono.classList.remove('bi-eye-slash');
                    icono.classList.add('bi-eye');
                }
            }

            document.addEventListener('DOMContentLoaded', function() {
                document.querySelector('input[name="sUsername"]').focus();
            });
    </script>

</body>
</html>