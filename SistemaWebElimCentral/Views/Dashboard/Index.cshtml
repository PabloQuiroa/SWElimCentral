@{
    ViewData["Title"] = "Inicio";
}

<style>
    /* ================================
               VARIABLES
            ================================ */
    :root {
        --morado-oscuro: #4A0E6E;
        --morado-medio: #7B2D9E;
        --dorado: #C9A84C;
        --dorado-claro: #E8C97A;
        --verde-uva: #4A6741;
        --crema: #F5F0E8;
    }

    /* ================================
               ENCABEZADO DEL DASHBOARD
            ================================ */
    .dashboard-header {
        background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
        border-radius: 15px;
        padding: 25px 30px;
        margin-bottom: 25px;
        color: white;
        position: relative;
        overflow: hidden;
    }

        .dashboard-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: url('/images/logo_elim_color.png') center/contain no-repeat;
            opacity: 0.08;
        }

    .dashboard-titulo {
        font-family: 'Cinzel', serif;
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .dashboard-subtitulo {
        color: var(--dorado-claro);
        font-size: 13px;
        letter-spacing: 1px;
    }

    .dashboard-fecha {
        color: rgba(255,255,255,0.7);
        font-size: 12px;
        margin-top: 5px;
    }

    /* ================================
               TARJETAS DE ESTADÍSTICAS
            ================================ */
    .stat-card {
        border: none;
        border-radius: 15px;
        padding: 25px;
        position: relative;
        overflow: hidden;
        transition: all 0.3s;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        height: 100%;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

    .stat-card-morado {
        background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
        color: white;
    }

    .stat-card-dorado {
        background: linear-gradient(135deg, #B8860B, var(--dorado));
        color: white;
    }

    .stat-card-verde {
        background: linear-gradient(135deg, #2D5016, var(--verde-uva));
        color: white;
    }

    .stat-card-gris {
        background: linear-gradient(135deg, #3D3D3D, #6D6D6D);
        color: white;
    }

    .stat-icono {
        font-size: 40px;
        opacity: 0.3;
        position: absolute;
        right: 20px;
        top: 20px;
    }

    .stat-numero {
        font-family: 'Cinzel', serif;
        font-size: 36px;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 5px;
    }

    .stat-label {
        font-size: 13px;
        opacity: 0.9;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .stat-detalle {
        font-size: 11px;
        opacity: 0.7;
        margin-top: 5px;
    }

    /* ================================
               TARJETAS DE CONTENIDO
            ================================ */
    .content-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .content-card-header {
        background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
        padding: 15px 20px;
        color: white;
        font-family: 'Cinzel', serif;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .content-card-body {
        padding: 20px;
        background: white;
    }

    /* ================================
               ACCESOS RÁPIDOS
            ================================ */
    .acceso-rapido {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px;
        border-radius: 12px;
        border: 2px solid var(--crema);
        text-decoration: none;
        color: var(--morado-oscuro);
        transition: all 0.3s;
        text-align: center;
        height: 100%;
    }

        .acceso-rapido:hover {
            background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
            color: white;
            border-color: transparent;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(74, 14, 110, 0.3);
        }

        .acceso-rapido i {
            font-size: 30px;
            margin-bottom: 8px;
            color: var(--morado-medio);
            transition: all 0.3s;
        }

        .acceso-rapido:hover i {
            color: var(--dorado-claro);
        }

        .acceso-rapido span {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

    /* ================================
               LÍNEA DORADA
            ================================ */
    .linea-dorada {
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--dorado), transparent);
        margin: 5px 0 15px 0;
        border-radius: 2px;
    }

    /* ================================
               CARRUSEL DE GRÁFICAS
            ================================ */
    .carrusel-header {
        justify-content: space-between;
    }

    .carrusel-titulo {
        display: flex;
        align-items: center;
        gap: 8px;
        transition: opacity 0.25s;
    }

    .carrusel-flechas {
        display: flex;
        gap: 6px;
    }

    .btn-flecha {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.35);
        background: rgba(255,255,255,0.12);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        padding: 0;
    }

        .btn-flecha:hover {
            background: var(--dorado);
            border-color: var(--dorado);
            color: var(--morado-oscuro);
        }

    .carrusel-ventana {
        overflow: hidden;
        position: relative;
    }

    .carrusel-pista {
        display: flex;
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .carrusel-slide {
        flex: 0 0 100%;
        min-width: 0;
        padding: 0 4px;
    }

    .slide-descripcion {
        font-size: 12px;
        color: #777;
        margin-bottom: 10px;
        min-height: 18px;
    }

        .slide-descripcion strong {
            color: var(--morado-oscuro);
            font-size: 14px;
        }

    .contenedor-grafica {
        position: relative;
        height: 300px;
    }

    .carrusel-puntos {
        display: flex;
        justify-content: center;
        gap: 18px;
        margin-top: 15px;
        flex-wrap: wrap;
    }

    .punto {
        border: none;
        background: none;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        font-weight: 700;
        color: #aaa;
        cursor: pointer;
        padding: 4px 2px;
        letter-spacing: 0.3px;
        transition: color 0.2s;
    }

        .punto::before {
            content: '';
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #ddd;
            transition: all 0.3s;
        }

        .punto.activo {
            color: var(--morado-oscuro);
        }

            .punto.activo::before {
                width: 24px;
                border-radius: 5px;
                background: linear-gradient(90deg, var(--morado-medio), var(--dorado));
            }

        .punto:hover {
            color: var(--morado-medio);
        }

    .sin-datos-dash {
        text-align: center;
        padding: 60px 20px;
        color: #999;
        font-size: 13px;
    }

    /* ================================
               HISTORIAL DE CONSTANCIAS
            ================================ */
    .tabla-historial thead th {
        background: var(--crema);
        color: var(--morado-oscuro);
        font-weight: 700;
        font-size: 11px;
        letter-spacing: 0.5px;
        padding: 10px 12px;
        border: none;
        text-transform: uppercase;
    }

    .tabla-historial tbody td {
        padding: 10px 12px;
        border-bottom: 1px solid #f0f0f0;
        vertical-align: middle;
        font-size: 13px;
    }

    .link-ver-todas {
        margin-left: auto;
        font-family: 'Segoe UI', sans-serif;
        font-size: 12px;
        font-weight: 700;
        color: var(--dorado-claro);
        text-decoration: none;
        letter-spacing: 0;
    }

        .link-ver-todas:hover {
            color: white;
        }

    /* ================================
               TARJETAS CLICABLES
            ================================ */
    a.stat-link {
        display: block;
        text-decoration: none;
        height: 100%;
    }

        a.stat-link .stat-card {
            cursor: pointer;
        }

    .stat-ir {
        position: absolute;
        right: 20px;
        bottom: 18px;
        font-size: 11px;
        font-weight: 700;
        opacity: 0.75;
        transition: all 0.3s;
    }

    a.stat-link:hover .stat-ir {
        opacity: 1;
        transform: translateX(3px);
    }

    /* ================================
               FILTRO POR AÑO
            ================================ */
    .filtro-anio {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 15px;
        position: relative;
        z-index: 1;
    }

        .filtro-anio label {
            color: var(--dorado-claro);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin: 0;
        }

        .filtro-anio select {
            border-radius: 10px;
            border: 2px solid var(--dorado);
            font-size: 13px;
            font-weight: 600;
            color: var(--morado-oscuro);
            padding: 6px 12px;
            min-width: 170px;
            cursor: pointer;
        }
</style>

@* Encabezado del Dashboard *@
<div class="dashboard-header">
    <div class="dashboard-titulo">
        <i class="bi bi-speedometer2 me-2"></i>Panel de Control
    </div>
    <div class="dashboard-subtitulo">Sistema de Gestión de Membresías</div>
    <div class="dashboard-fecha">
        <i class="bi bi-calendar3 me-1"></i>
        @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-GT"))
    </div>
</div>

@* Tarjetas de resumen: al hacer clic llevan a cada módulo *@
<div class="row g-4 mb-4">

    <div class="col-xl-3 col-md-6">
        <a href="/Miembros" class="stat-link" title="Ir a Total de Miembros">
            <div class="stat-card stat-card-morado">
                <i class="bi bi-people-fill stat-icono"></i>
                <div class="stat-numero">@ViewBag.TotalMiembros</div>
                <div class="stat-label">Total de Miembros</div>
                <div class="stat-detalle">Miembros activos registrados</div>
                <span class="stat-ir">Ver <i class="bi bi-arrow-right"></i></span>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6">
        <a href="/NucleoFamiliar" class="stat-link" title="Ir a Grupos Familiares">
            <div class="stat-card stat-card-dorado">
                <i class="bi bi-house-heart-fill stat-icono"></i>
                <div class="stat-numero">@ViewBag.TotalFamilias</div>
                <div class="stat-label">Grupos Familiares</div>
                <div class="stat-detalle">Familias registradas</div>
                <span class="stat-ir">Ver <i class="bi bi-arrow-right"></i></span>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6">
        <a href="/Constancias" class="stat-link" title="Ir a Constancias Emitidas">
            <div class="stat-card stat-card-verde">
                <i class="bi bi-file-earmark-check-fill stat-icono"></i>
                <div class="stat-numero">@ViewBag.TotalConstancias</div>
                <div class="stat-label">Constancias Emitidas</div>
                <div class="stat-detalle">Este mes</div>
                <span class="stat-ir">Ver <i class="bi bi-arrow-right"></i></span>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6">
        <a href="/Areas" class="stat-link" title="Ir a Áreas de Servicio">
            <div class="stat-card stat-card-gris">
                <i class="bi bi-diagram-3-fill stat-icono"></i>
                <div class="stat-numero">@ViewBag.TotalAreas</div>
                <div class="stat-label">Áreas de Servicio</div>
                <div class="stat-detalle">Ministerios activos</div>
                <span class="stat-ir">Ver <i class="bi bi-arrow-right"></i></span>
            </div>
        </a>
    </div>

</div>

@* Accesos rápidos *@
<div class="content-card">
    <div class="content-card-header">
        <i class="bi bi-lightning-fill"></i>
        Accesos Rápidos
    </div>
    <div class="content-card-body">
        <div class="linea-dorada"></div>
        <div class="row g-3">
                    <div class="col-xl-2 col-md-4 col-6">
                        <a href="/Miembros/Crear" class="acceso-rapido">
                            <i class="bi bi-person-plus-fill"></i>
                            <span>Nuevo Miembro</span>
                        </a>
                    </div>
                    <div class="col-xl-2 col-md-4 col-6">
                        <a href="/Constancias/Generar" class="acceso-rapido">
                            <i class="bi bi-file-earmark-plus-fill"></i>
                            <span>Nueva Constancia</span>
                        </a>
                    </div>
                    <div class="col-xl-2 col-md-4 col-6">
                        <a href="/Miembros" class="acceso-rapido">
                            <i class="bi bi-search"></i>
                            <span>Buscar Miembro</span>
                        </a>
                    </div>
                    <div class="col-xl-2 col-md-4 col-6">
                        <a href="/Bitacora" class="acceso-rapido">
                            <i class="bi bi-journal-text"></i>
                            <span>Ver Bitácora</span>
                        </a>
                    </div>
                    <div class="col-xl-2 col-md-4 col-6">
                        <a href="/NucleoFamiliar/Crear" class="acceso-rapido">
                            <i class="bi bi-house-add-fill"></i>
                            <span>Nueva Familia</span>
                        </a>
                    </div>
                    <div class="col-xl-2 col-md-4 col-6">
                        <a href="/NucleoFamiliar" class="acceso-rapido">
                            <i class="bi bi-house-heart-fill"></i>
                            <span>Ver Familias</span>
                        </a>
                    </div>
        </div>
    </div>
</div>
