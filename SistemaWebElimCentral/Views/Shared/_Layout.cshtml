<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Elim Central</title>

    @* Bootstrap 5 *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    @* Bootstrap Icons *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    @* Google Fonts *@
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lato:wght@300;400;600;700&display=swap" rel="stylesheet" />

    <style>
            /* ================================
                       VARIABLES
                    ================================ */
            :root {
                --morado-oscuro: #4A0E6E;
                --morado-medio: #7B2D9E;
                --dorado: #C9A84C;
                --dorado-claro: #E8C97A;
                --verde-uva: #4A6741;
                --crema: #F5F0E8;
            }

            body {
                font-family: 'Lato', sans-serif;
                background-color: #f8f5ff;
                margin: 0;
                padding: 0;
            }

            /* ================================
                       NAVBAR SUPERIOR
                    ================================ */
            .navbar-elim {
                background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
                padding: 0 20px;
                box-shadow: 0 2px 15px rgba(0,0,0,0.3);
                min-height: 65px;
            }

            .navbar-brand-elim {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

            .navbar-logo {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                border: 2px solid var(--dorado);
                object-fit: contain;
                background: white;
                padding: 2px;
            }

            .navbar-titulo {
                color: white;
                font-family: 'Cinzel', serif;
                font-size: 14px;
                font-weight: 700;
                letter-spacing: 0.5px;
                line-height: 1.2;
            }

            .navbar-subtitulo {
                color: var(--dorado-claro);
                font-size: 10px;
                letter-spacing: 1px;
                text-transform: uppercase;
            }

            /* ================================
                       MENÚ DE NAVEGACIÓN
                    ================================ */
            .nav-link-elim {
                color: rgba(255,255,255,0.85) !important;
                font-family: 'Lato', sans-serif;
                font-size: 13px;
                font-weight: 600;
                padding: 8px 14px !important;
                border-radius: 8px;
                transition: all 0.3s;
                display: flex;
                align-items: center;
                gap: 6px;
            }

                .nav-link-elim:hover {
                    background: rgba(201, 168, 76, 0.2);
                    color: var(--dorado-claro) !important;
                }

                .nav-link-elim.active {
                    background: rgba(201, 168, 76, 0.3);
                    color: var(--dorado-claro) !important;
                }

            /* ================================
                       DROPDOWN DEL MENÚ
                    ================================ */
            .dropdown-menu-elim {
                background: white;
                border: none;
                border-radius: 12px;
                box-shadow: 0 8px 30px rgba(74, 14, 110, 0.2);
                padding: 8px;
                min-width: 200px;
            }

            .dropdown-item-elim {
                border-radius: 8px;
                padding: 8px 15px;
                font-size: 13px;
                color: var(--morado-oscuro);
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s;
            }

                .dropdown-item-elim:hover {
                    background: var(--crema);
                    color: var(--morado-oscuro);
                }

            .dropdown-divider-elim {
                border-color: rgba(201, 168, 76, 0.3);
                margin: 5px 0;
            }

            /* ================================
                       USUARIO CONECTADO
                    ================================ */
            .usuario-conectado {
                display: flex;
                align-items: center;
                gap: 8px;
                color: white;
                cursor: pointer;
                padding: 5px 10px;
                border-radius: 8px;
                transition: all 0.3s;
                border: 1px solid rgba(201, 168, 76, 0.4);
            }

                .usuario-conectado:hover {
                    background: rgba(201, 168, 76, 0.2);
                }

            .usuario-avatar {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--dorado), var(--dorado-claro));
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 13px;
                color: var(--morado-oscuro);
            }

            .usuario-nombre {
                font-size: 13px;
                font-weight: 600;
                color: white;
            }

            .usuario-perfil {
                font-size: 10px;
                color: var(--dorado-claro);
                letter-spacing: 0.5px;
            }

            /* ================================
                       CONTENIDO PRINCIPAL
                    ================================ */
            .contenido-principal {
                padding: 25px;
                min-height: calc(100vh - 65px);
            }

            /* ================================
                       LÍNEA DORADA DECORATIVA
                    ================================ */
            .linea-dorada-navbar {
                height: 2px;
                background: linear-gradient(90deg, transparent, var(--dorado), transparent);
            }

            /* ================================
                       TOGGLER MOBILE
                    ================================ */
            .navbar-toggler-elim {
                border-color: rgba(201, 168, 76, 0.5);
                padding: 4px 8px;
            }

                .navbar-toggler-elim:focus {
                    box-shadow: none;
                }

                .navbar-toggler-elim .bi {
                    color: var(--dorado-claro);
                    font-size: 20px;
                }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @* Navbar principal *@
    <nav class="navbar navbar-expand-lg navbar-elim">
        <div class="container-fluid">

            @* Logo y título *@
            <a class="navbar-brand-elim" href="/Dashboard">
                <img src="~/images/logo_elim_color.png"
                     alt="Elim Central"
                     class="navbar-logo" />
                <div>
                    <div class="navbar-titulo">Elim Central</div>
                    <div class="navbar-subtitulo">Gestión de Membresías</div>
                </div>
            </a>

            @* Botón mobile *@
            <button class="navbar-toggler navbar-toggler-elim"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarElim">
                <i class="bi bi-list"></i>
            </button>

            @* Menú *@
            <div class="collapse navbar-collapse" id="navbarElim">
                <ul class="navbar-nav me-auto ms-3">

                    @* Dashboard *@
                    <li class="nav-item">
                        <a class="nav-link-elim @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                           href="/Dashboard">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>

                    @* Miembros *@
                    <li class="nav-item">
                        <a class="nav-link-elim @(ViewContext.RouteData.Values["controller"]?.ToString() == "Miembros" ? "active" : "")"
                           href="/Miembros">
                            <i class="bi bi-people-fill"></i> Miembros
                        </a>
                    </li>

                    @* Familias *@
                    <li class="nav-item">
                        <a class="nav-link-elim @(ViewContext.RouteData.Values["controller"]?.ToString() == "Familias" ? "active" : "")"
                           href="/Familias">
                            <i class="bi bi-house-heart-fill"></i> Familias
                        </a>
                    </li>

                    @* Constancias *@
                    <li class="nav-item">
                        <a class="nav-link-elim @(ViewContext.RouteData.Values["controller"]?.ToString() == "Constancias" ? "active" : "")"
                           href="/Constancias">
                            <i class="bi bi-file-earmark-text-fill"></i> Constancias
                        </a>
                    </li>

                    @* Portal Web *@
                    <li class="nav-item">
                        <a class="nav-link-elim @(ViewContext.RouteData.Values["controller"]?.ToString() == "Portal" ? "active" : "")"
                           href="/Portal">
                            <i class="bi bi-globe"></i> Portal Web
                        </a>
                    </li>

                    @* Administración dropdown *@
                    <li class="nav-item dropdown">
                        <a class="nav-link-elim dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">
                            <i class="bi bi-gear-fill"></i> Administración
                        </a>
                        <ul class="dropdown-menu dropdown-menu-elim">
                            <li>
                                <a class="dropdown-item dropdown-item-elim" href="/Usuarios">
                                    <i class="bi bi-person-badge-fill"></i> Usuarios
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item dropdown-item-elim" href="/Perfiles">
                                    <i class="bi bi-shield-lock-fill"></i> Perfiles y Permisos
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item dropdown-item-elim" href="/Areas">
                                    <i class="bi bi-diagram-3-fill"></i> Áreas de Servicio
                                </a>
                            </li>
                            <li><hr class="dropdown-divider dropdown-divider-elim"></li>
                            <li>
                                <a class="dropdown-item dropdown-item-elim" href="/Bitacora">
                                    <i class="bi bi-journal-text"></i> Bitácora
                                </a>
                            </li>
                        </ul>
                    </li>

                </ul>

                @* Usuario conectado *@
                <div class="dropdown">
                    <div class="usuario-conectado dropdown-toggle"
                         data-bs-toggle="dropdown">
                        <div class="usuario-avatar">
                            @(ViewBag.NombreUsuario != null ? ViewBag.NombreUsuario.ToString().Substring(0, 1).ToUpper() : "U")
                        </div>
                        <div>
                            <div class="usuario-nombre">
                                @(ViewBag.NombreUsuario ?? "Usuario")
                            </div>
                            <div class="usuario-perfil">
                                @(ViewBag.NombrePerfil ?? "")
                            </div>
                        </div>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-elim">
                        <li>
                            <a class="dropdown-item dropdown-item-elim" href="#">
                                <i class="bi bi-person-circle"></i> Mi Perfil
                            </a>
                        </li>
                        <li><hr class="dropdown-divider dropdown-divider-elim"></li>
                        <li>
                            <a class="dropdown-item dropdown-item-elim text-danger"
                               href="/Login/CerrarSesion">
                                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                            </a>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
    </nav>

    @* Línea dorada decorativa *@
    <div class="linea-dorada-navbar"></div>

    @* Contenido principal *@
    <div class="contenido-principal">
        @RenderBody()
    </div>

    @* Bootstrap JS *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>