@* Pablo José Quiroa Martínez - 0901-22-2929 *@
@{
    ViewData["Title"] = "Usuarios";
}

<style>
    :root {
        --morado-oscuro: #4A0E6E;
        --morado-medio: #7B2D9E;
        --dorado: #C9A84C;
        --dorado-claro: #E8C97A;
        --crema: #F5F0E8;
    }

    .page-header {
        background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
        border-radius: 15px;
        padding: 20px 25px;
        margin-bottom: 20px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .page-header-titulo {
        font-family: 'Cinzel', serif;
        font-size: 20px;
        font-weight: 700;
        margin: 0;
    }

    .btn-nuevo {
        background: linear-gradient(135deg, var(--dorado), var(--dorado-claro));
        color: var(--morado-oscuro);
        border: none;
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 13px;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s;
    }

        .btn-nuevo:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(201, 168, 76, 0.4);
            color: var(--morado-oscuro);
        }

    .tabla-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
    }

    .tabla-header {
        background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
        padding: 15px 20px;
        color: white;
        font-family: 'Cinzel', serif;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .tabla-usuarios thead th {
        background: var(--crema);
        color: var(--morado-oscuro);
        font-weight: 700;
        font-size: 12px;
        letter-spacing: 0.5px;
        padding: 12px 15px;
        border: none;
        text-transform: uppercase;
    }

    .tabla-usuarios tbody td {
        padding: 12px 15px;
        border-bottom: 1px solid #f0f0f0;
        vertical-align: middle;
        font-size: 13px;
    }

    .tabla-usuarios tbody tr:hover {
        background: #faf8ff;
    }

    .usuario-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 14px;
        border: 2px solid var(--dorado);
    }

    .badge-activo {
        background: #d4edda;
        color: #155724;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .badge-inactivo {
        background: #f8d7da;
        color: #721c24;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .badge-bloqueado {
        background: #fff3cd;
        color: #856404;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .badge-perfil {
        background: #e8f4fd;
        color: var(--morado-oscuro);
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        border: 1px solid rgba(74,14,110,0.2);
    }

    .btn-accion {
        padding: 5px 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s;
    }

    .btn-editar {
        background: #fff3cd;
        color: #856404;
    }

        .btn-editar:hover {
            background: #ffc107;
            color: white;
        }

    .btn-contrasena {
        background: #e8f4fd;
        color: #0d6efd;
    }

        .btn-contrasena:hover {
            background: #0d6efd;
            color: white;
        }

    .btn-desbloquear {
        background: #d1e7dd;
        color: #0f5132;
    }

        .btn-desbloquear:hover {
            background: #198754;
            color: white;
        }

    .btn-estado-on {
        background: #f8d7da;
        color: #721c24;
    }

        .btn-estado-on:hover {
            background: #dc3545;
            color: white;
        }

    .btn-estado-off {
        background: #d4edda;
        color: #155724;
    }

        .btn-estado-off:hover {
            background: #198754;
            color: white;
        }
</style>

@* Encabezado *@
<div class="page-header">
    <div>
        <p class="page-header-titulo">
            <i class="bi bi-person-badge-fill me-2"></i>Gesti&oacute;n de Usuarios
        </p>
        <small style="color: var(--dorado-claro); font-size: 12px;">
            Administraci&oacute;n de usuarios del sistema
        </small>
    </div>
    <a href="/Usuarios/Crear" class="btn-nuevo">
        <i class="bi bi-person-plus-fill"></i>
        Nuevo Usuario
    </a>
</div>

@* Mensajes *@
@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3"
         style="border-radius: 10px; border-left: 4px solid #198754;">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3"
         style="border-radius: 10px; border-left: 4px solid #dc3545;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Tabla *@
<div class="tabla-card">
    <div class="tabla-header">
        <span><i class="bi bi-table me-2"></i>Listado de Usuarios</span>
        <span style="font-size: 12px; color: var(--dorado-claro);">
            @(ViewData.Model != null ? ((dynamic)ViewData.Model).Count : 0) usuario(s)
        </span>
    </div>

    <div class="table-responsive">
        <table class="tabla-usuarios table">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Nombre Completo</th>
                    <th>Correo</th>
                    <th>Perfil</th>
                    <th>&Uacute;ltimo Acceso</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var usuario in (dynamic)Model)
                    {
                        bool bBloqueado = false;
                        try
                        {
                            bBloqueado = usuario.iCmp_Intentos_Fallidos_Usuario >= 3;
                        }
                        catch { }

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="usuario-avatar">
                                        @usuario.sCmp_Nombre_Usuario.ToString().Substring(0, 1).ToUpper()
                                    </div>
                                    <strong style="color: var(--morado-oscuro);">
                                        @@@usuario.sCmp_Username_Usuario
                                    </strong>
                                </div>
                            </td>
                            <td>@usuario.sCmp_Nombre_Usuario</td>
                            <td>@(usuario.sCmp_Correo_Usuario ?? "No registrado")</td>
                            <td>
                                <span class="badge-perfil">@usuario.NombrePerfil</span>
                            </td>
                            <td>
                                @(usuario.dCmp_Ultimo_Acceso_Usuario != null
                                    ? ((DateTime)usuario.dCmp_Ultimo_Acceso_Usuario).ToString("dd/MM/yyyy HH:mm")
                                    : "Nunca")
                            </td>
                            <td>
                                @if (!usuario.bCmp_Estado_Usuario)
                                {
                                    <span class="badge-inactivo">Inactivo</span>
                                }
                                else
                                {
                                    <span class="badge-activo">Activo</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <a href="/Usuarios/Editar/@usuario.iPk_Id_Usuario"
                                       class="btn-accion btn-editar"
                                       title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a href="/Usuarios/CambiarContrasena/@usuario.iPk_Id_Usuario"
                                       class="btn-accion btn-contrasena"
                                       title="Cambiar contrase&ntilde;a">
                                        <i class="bi bi-key-fill"></i>
                                    </a>
                                    <form method="post"
                                          action="/Usuarios/Desbloquear"
                                          style="display:inline;">
                                        <input type="hidden" name="id"
                                               value="@usuario.iPk_Id_Usuario" />
                                        <button type="submit"
                                                class="btn-accion btn-desbloquear"
                                                title="Desbloquear"
                                                onclick="return confirm('Desbloquear este usuario?')">
                                            <i class="bi bi-unlock-fill"></i>
                                        </button>
                                    </form>
                                    <form method="post"
                                          action="/Usuarios/CambiarEstado"
                                          style="display:inline;">
                                        <input type="hidden" name="id"
                                               value="@usuario.iPk_Id_Usuario" />
                                        <button type="submit"
                                                class="btn-accion @(usuario.bCmp_Estado_Usuario ? "btn-estado-on" : "btn-estado-off")"
                                                title="@(usuario.bCmp_Estado_Usuario ? "Desactivar" : "Activar")"
                                                onclick="return confirm('@(usuario.bCmp_Estado_Usuario ? "Desactivar" : "Activar") este usuario?')">
                                            <i class="bi bi-@(usuario.bCmp_Estado_Usuario ? "person-x-fill" : "person-check-fill")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>