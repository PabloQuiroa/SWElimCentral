@model SistemaWebElimCentral.Models.Seguridad.Mdl_Usuario
@{
    ViewData["Title"] = "Editar Usuario";
}

<style>
    :root {
        --morado-oscuro: #4A0E6E;
        --morado-medio: #7B2D9E;
        --dorado: #C9A84C;
        --dorado-claro: #E8C97A;
        --crema: #F5F0E8;
    }

    .page-header {
        background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
        border-radius: 15px;
        padding: 20px 25px;
        margin-bottom: 20px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .page-header-titulo {
        font-family: 'Cinzel', serif;
        font-size: 20px;
        font-weight: 700;
        margin: 0;
    }

    .btn-regresar {
        background: rgba(255,255,255,0.2);
        color: white;
        border: 1px solid rgba(255,255,255,0.4);
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s;
    }

        .btn-regresar:hover {
            background: rgba(255,255,255,0.3);
            color: white;
        }

    .seccion-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        margin-bottom: 20px;
    }

    .seccion-header {
        background: var(--crema);
        padding: 12px 20px;
        border-left: 4px solid var(--dorado);
        font-family: 'Cinzel', serif;
        font-size: 13px;
        font-weight: 700;
        color: var(--morado-oscuro);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .seccion-body {
        padding: 20px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--morado-oscuro);
        margin-bottom: 5px;
    }

    .form-control, .form-select {
        border-radius: 8px;
        font-size: 13px;
        border-color: #dee2e6;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--dorado);
            box-shadow: 0 0 0 0.2rem rgba(201, 168, 76, 0.25);
        }

        .form-control:disabled {
            background: var(--crema);
            color: var(--morado-oscuro);
            font-weight: 700;
        }

    .btn-guardar {
        background: linear-gradient(135deg, var(--dorado), var(--dorado-claro));
        color: var(--morado-oscuro);
        border: none;
        padding: 12px 30px;
        border-radius: 10px;
        font-family: 'Cinzel', serif;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.3s;
        box-shadow: 0 4px 15px rgba(201, 168, 76, 0.3);
    }

        .btn-guardar:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(201, 168, 76, 0.4);
        }

    .btn-cancelar {
        background: var(--crema);
        color: var(--morado-oscuro);
        border: 1px solid #dee2e6;
        padding: 12px 25px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s;
    }

        .btn-cancelar:hover {
            background: #e9e4f0;
            color: var(--morado-oscuro);
        }

    .campo-requerido::after {
        content: ' *';
        color: red;
    }
</style>

<div class="page-header">
    <div>
        <p class="page-header-titulo">
            <i class="bi bi-pencil-fill me-2"></i>Editar Usuario
        </p>
        <small style="color: var(--dorado-claro); font-size: 12px;">
            Actualice la informaci&oacute;n del usuario
        </small>
    </div>
    <a href="/Usuarios" class="btn-regresar">
        <i class="bi bi-arrow-left"></i> Regresar
    </a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3"
         style="border-radius: 10px; border-left: 4px solid #dc3545;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" action="/Usuarios/Editar">
    <input type="hidden" name="iIdUsuario" value="@Model.iPk_Id_Usuario" />

    <div class="seccion-card">
        <div class="seccion-header">
            <i class="bi bi-person-badge-fill"></i> Datos del Usuario
        </div>
        <div class="seccion-body">
            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Nombre de Usuario</label>
                    <input type="text"
                           class="form-control"
                           value="@@@Model.sCmp_Username_Usuario"
                           disabled />
                    <small class="text-muted" style="font-size: 11px;">
                        El nombre de usuario no se puede cambiar
                    </small>
                </div>

                <div class="col-md-6">
                    <label class="form-label campo-requerido">Nombre Completo</label>
                    <input type="text"
                           name="sNombreUsuario"
                           class="form-control"
                           value="@Model.sCmp_Nombre_Usuario"
                           maxlength="100"
                           required />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Correo Electr&oacute;nico</label>
                    <input type="email"
                           name="sCorreo"
                           class="form-control"
                           value="@Model.sCmp_Correo_Usuario"
                           maxlength="100" />
                </div>

                <div class="col-md-6">
                    <label class="form-label campo-requerido">Perfil</label>
                    <select name="iIdPerfil" class="form-select" required>
                        <option value="">Seleccione un perfil</option>
                        @foreach (var perfil in (SelectList)ViewBag.Perfiles)
                        {
                            <option value="@perfil.Value"
                                    selected="@(perfil.Value == Model.iFk_Id_Perfil.ToString())">
                                @perfil.Text
                            </option>
                        }
                    </select>
                </div>

            </div>
        </div>
    </div>

    <div class="d-flex gap-3 justify-content-end">
        <a href="/Usuarios" class="btn-cancelar">
            <i class="bi bi-x-circle me-1"></i> Cancelar
        </a>
        <button type="submit" class="btn-guardar">
            <i class="bi bi-check-circle-fill me-2"></i>
            Guardar Cambios
        </button>
    </div>
</form>