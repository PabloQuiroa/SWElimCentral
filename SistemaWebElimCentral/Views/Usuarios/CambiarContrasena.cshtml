@* Pablo José Quiroa Martínez - 0901-22-2929 *@
@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<style>
    :root {
        --morado-oscuro: #4A0E6E;
        --morado-medio: #7B2D9E;
        --dorado: #C9A84C;
        --dorado-claro: #E8C97A;
        --crema: #F5F0E8;
    }

    .page-header {
        background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
        border-radius: 15px;
        padding: 20px 25px;
        margin-bottom: 20px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .page-header-titulo {
        font-family: 'Cinzel', serif;
        font-size: 20px;
        font-weight: 700;
        margin: 0;
    }

    .btn-regresar {
        background: rgba(255,255,255,0.2);
        color: white;
        border: 1px solid rgba(255,255,255,0.4);
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s;
    }

        .btn-regresar:hover {
            background: rgba(255,255,255,0.3);
            color: white;
        }

    .seccion-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        margin-bottom: 20px;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .seccion-header {
        background: var(--crema);
        padding: 12px 20px;
        border-left: 4px solid var(--dorado);
        font-family: 'Cinzel', serif;
        font-size: 13px;
        font-weight: 700;
        color: var(--morado-oscuro);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .seccion-body {
        padding: 25px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--morado-oscuro);
        margin-bottom: 5px;
    }

    .form-control {
        border-radius: 8px;
        font-size: 13px;
        border-color: #dee2e6;
    }

        .form-control:focus {
            border-color: var(--dorado);
            box-shadow: 0 0 0 0.2rem rgba(201, 168, 76, 0.25);
        }

    .btn-guardar {
        background: linear-gradient(135deg, var(--dorado), var(--dorado-claro));
        color: var(--morado-oscuro);
        border: none;
        padding: 12px 30px;
        border-radius: 10px;
        font-family: 'Cinzel', serif;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.3s;
        box-shadow: 0 4px 15px rgba(201, 168, 76, 0.3);
        width: 100%;
    }

        .btn-guardar:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(201, 168, 76, 0.4);
        }

    .btn-cancelar {
        background: var(--crema);
        color: var(--morado-oscuro);
        border: 1px solid #dee2e6;
        padding: 12px 25px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s;
        width: 100%;
        text-align: center;
        display: block;
    }

        .btn-cancelar:hover {
            background: #e9e4f0;
            color: var(--morado-oscuro);
        }

    .requisitos-contrasena {
        background: var(--crema);
        border-radius: 8px;
        padding: 10px 15px;
        font-size: 12px;
        margin-top: 5px;
    }

    .requisito {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 3px;
        color: #999;
    }

        .requisito.cumplido {
            color: #198754;
        }

    .usuario-info {
        background: linear-gradient(135deg, var(--morado-oscuro), var(--morado-medio));
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 20px;
        color: white;
        text-align: center;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }
</style>

<div class="page-header">
    <div>
        <p class="page-header-titulo">
            <i class="bi bi-key-fill me-2"></i>Cambiar Contraseña
        </p>
        <small style="color: var(--dorado-claro); font-size: 12px;">
            Establezca una nueva contraseña para el usuario
        </small>
    </div>
    <a href="/Usuarios" class="btn-regresar">
        <i class="bi bi-arrow-left"></i> Regresar
    </a>
</div>

@* Info del usuario *@
<div class="usuario-info">
    <i class="bi bi-person-circle" style="font-size: 30px; color: var(--dorado-claro);"></i>
    <div style="font-family: 'Cinzel', serif; font-size: 16px; font-weight: 700; margin-top: 5px;">
        @ViewBag.NombreUsuarioEditar
    </div>
    <div style="font-size: 12px; color: var(--dorado-claro);">
        Cambiando contraseña de este usuario
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3"
         style="border-radius: 10px; max-width: 600px; margin: 0 auto 15px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" action="/Usuarios/CambiarContrasena">
    <input type="hidden" name="iIdUsuario" value="@ViewBag.IdUsuario" />

    <div class="seccion-card">
        <div class="seccion-header">
            <i class="bi bi-shield-lock-fill"></i> Nueva Contraseña
        </div>
        <div class="seccion-body">
            <div class="mb-3">
                <label class="form-label">Nueva Contraseña</label>
                <div class="input-group">
                    <input type="password"
                           name="sNuevaContrasena"
                           id="inputNueva"
                           class="form-control"
                           placeholder="Mínimo 8 caracteres"
                           oninput="verificarContrasena(this)"
                           required />
                    <button class="btn btn-outline-secondary"
                            type="button"
                            onclick="togglePassword('inputNueva', 'ojoNueva')">
                        <i class="bi bi-eye" id="ojoNueva"></i>
                    </button>
                </div>
                <div class="requisitos-contrasena">
                    <div class="requisito" id="req-longitud">
                        <i class="bi bi-x-circle"></i> Mínimo 8 caracteres
                    </div>
                    <div class="requisito" id="req-mayuscula">
                        <i class="bi bi-x-circle"></i> Al menos una mayúscula
                    </div>
                    <div class="requisito" id="req-numero">
                        <i class="bi bi-x-circle"></i> Al menos un número
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">Confirmar Contraseña</label>
                <div class="input-group">
                    <input type="password"
                           name="sConfirmarContrasena"
                           id="inputConfirmar"
                           class="form-control"
                           placeholder="Repita la contraseña"
                           oninput="verificarCoincidencia()"
                           required />
                    <button class="btn btn-outline-secondary"
                            type="button"
                            onclick="togglePassword('inputConfirmar', 'ojoConfirmar')">
                        <i class="bi bi-eye" id="ojoConfirmar"></i>
                    </button>
                </div>
                <small id="mensajeCoincidencia" style="font-size: 11px;"></small>
            </div>

            <div class="d-flex gap-3">
                <a href="/Usuarios" class="btn-cancelar">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </a>
                <button type="submit"
                        class="btn-guardar"
                        onclick="return validarFormulario()">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Cambiar Contraseña
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        function verificarContrasena(input) {
            const val = input.value;
            actualizarRequisito('req-longitud', val.length >= 8);
            actualizarRequisito('req-mayuscula', /[A-Z]/.test(val));
            actualizarRequisito('req-numero', /[0-9]/.test(val));
            verificarCoincidencia();
        }

        function actualizarRequisito(id, cumplido) {
            const el = document.getElementById(id);
            if (cumplido) {
                el.classList.add('cumplido');
                el.querySelector('i').className = 'bi bi-check-circle-fill';
            } else {
                el.classList.remove('cumplido');
                el.querySelector('i').className = 'bi bi-x-circle';
            }
        }

        function verificarCoincidencia() {
            const c1 = document.getElementById('inputNueva').value;
            const c2 = document.getElementById('inputConfirmar').value;
            const msg = document.getElementById('mensajeCoincidencia');
            if (c2 === '') {
                msg.innerHTML = '';
                return;
            }
            if (c1 === c2) {
                msg.innerHTML = '<span style="color:#198754;"><i class="bi bi-check-circle"></i> Las contrase\u00f1as coinciden</span>';
            } else {
                msg.innerHTML = '<span style="color:red;"><i class="bi bi-x-circle"></i> Las contrase\u00f1as no coinciden</span>';
            }
        }

        function validarFormulario() {
            const contrasena = document.getElementById('inputNueva').value;
            const confirmar = document.getElementById('inputConfirmar').value;

            if (contrasena.length < 8) {
                alert('La contrase\u00f1a debe tener al menos 8 caracteres.');
                return false;
            }
            if (!/[A-Z]/.test(contrasena)) {
                alert('La contrase\u00f1a debe tener al menos una may\u00fascula.');
                return false;
            }
            if (!/[0-9]/.test(contrasena)) {
                alert('La contrase\u00f1a debe tener al menos un n\u00famero.');
                return false;
            }
            if (contrasena !== confirmar) {
                alert('Las contrase\u00f1as no coinciden.');
                return false;
            }
            return true;
        }
    </script>
}